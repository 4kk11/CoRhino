<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>CoRhino</AssemblyName>
    <OutputType>Library</OutputType>
    <TargetExt>.rhp</TargetExt>
    <RootNamespace>CoRhino</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>0.0.1</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Unix'">
    <RhinoResources>/Applications/Rhino 8.app/Contents/Frameworks/RhCore.framework/Versions/A/Resources</RhinoResources>
    <PluginDestDir>$(HOME)/Library/Application Support/McNeel/Rhinoceros/8.0/MacPlugIns/CoRhino</PluginDestDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <RhinoResources>C:\Program Files\Rhino 8\System</RhinoResources>
    <PluginDestDir>$(APPDATA)\McNeel\Rhinoceros\myplugins\CoRhino</PluginDestDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RhinoCommon">
      <HintPath>$(RhinoResources)/RhinoCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eto">
      <HintPath>$(RhinoResources)/Eto.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rhino.UI">
      <HintPath>$(RhinoResources)/Rhino.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Unix'">
    <Reference Include="Microsoft.macOS">
      <HintPath>$(RhinoResources)/Microsoft.macOS.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Porta.Pty" Version="1.0.7" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\icon.png" LogicalName="CoRhino.icon.png" />
  </ItemGroup>

  <!-- Build the WebView UI (vite) → ../ui/dist. Anchored to the install flow via
       CopyWebUi's DependsOnTargets (NOT BeforeTargets="Build": that injects right
       before Build's empty body, i.e. AFTER PostBuildEvent, so vite would run too
       late). This makes `dotnet build` the single entry point — no separate
       `npm run build` step. -->
  <Target Name="BuildUi">
    <Exec Command="npm install" WorkingDirectory="$(MSBuildProjectDirectory)/../ui"
          Condition="!Exists('$(MSBuildProjectDirectory)/../ui/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/../ui" />
  </Target>

  <!-- Copy the built UI into $(TargetDir)/web so PostBuild ships it to the plugin dir.
       DependsOnTargets BuildUi guarantees dist/ exists before the glob is evaluated. -->
  <Target Name="CopyWebUi" DependsOnTargets="BuildUi">
    <ItemGroup>
      <WebUiFiles Include="$(MSBuildProjectDirectory)/../ui/dist/**/*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebUiFiles)" DestinationFolder="$(TargetDir)web/%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Flatten native libs to TargetDir root so the loader finds them via the plugin assembly dir. -->
  <Target Name="FlattenNativeLibs" AfterTargets="Build">
    <!-- macOS: fuse the per-arch dylibs into ONE universal binary. Copying both
         osx-arm64 and osx-x64 to the flat dir collides on filename and leaves
         whichever Copy ran last (x64) — which fails to dlopen in arm64 Rhino with
         "incompatible architecture". lipo produces a fat dylib that loads on both
         Apple Silicon and Intel. -->
    <Exec Condition="'$(OS)' == 'Unix'"
          Command="lipo -create '$(TargetDir)runtimes/osx-arm64/native/libporta_pty.dylib' '$(TargetDir)runtimes/osx-x64/native/libporta_pty.dylib' -output '$(TargetDir)libporta_pty.dylib'" />
    <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
      <NativeLib Include="$(TargetDir)runtimes\win-x64\native\*.dll" />
      <NativeLib Include="$(TargetDir)runtimes\win-x64\native\*.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeLib)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'@(NativeLib)' != ''" />
  </Target>

  <!-- Ship the bundled Claude Code plugin (onboarding skills like save-rhino-skill)
       next to the assembly, like web/. CoRhinoPanel passes it to claude via a second
       plugin-dir flag at spawn. -->
  <Target Name="CopyCcPlugin">
    <ItemGroup>
      <CcPluginFiles Include="$(MSBuildProjectDirectory)/../cc-plugin/**/*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CcPluginFiles)" DestinationFolder="$(TargetDir)cc-plugin/%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" DependsOnTargets="FlattenNativeLibs;CopyWebUi;CopyCcPlugin">
    <ItemGroup>
      <PluginFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(PluginDestDir)" />
    <!-- SkipUnchangedFiles + ContinueOnError lets the build succeed even when Rhino has some DLLs locked.
         The locked DLLs are unchanged native deps, so skipping them is harmless. -->
    <Copy SourceFiles="@(PluginFiles)" DestinationFiles="@(PluginFiles->'$(PluginDestDir)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />
    <Message Text="CoRhino installed to $(PluginDestDir)" Importance="high" />
  </Target>
</Project>
