<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>RhinoClaudePanel</AssemblyName>
    <OutputType>Library</OutputType>
    <TargetExt>.rhp</TargetExt>
    <RootNamespace>RhinoClaudePanel</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>0.0.1</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Unix'">
    <RhinoResources>/Applications/Rhino 8.app/Contents/Frameworks/RhCore.framework/Versions/A/Resources</RhinoResources>
    <PluginDestDir>$(HOME)/Library/Application Support/McNeel/Rhinoceros/8.0/MacPlugIns/RhinoClaudePanel</PluginDestDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <RhinoResources>C:\Program Files\Rhino 8\System</RhinoResources>
    <PluginDestDir>$(APPDATA)\McNeel\Rhinoceros\myplugins\RhinoClaudePanel</PluginDestDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RhinoCommon">
      <HintPath>$(RhinoResources)/RhinoCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Eto">
      <HintPath>$(RhinoResources)/Eto.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rhino.UI">
      <HintPath>$(RhinoResources)/Rhino.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Unix'">
    <Reference Include="Microsoft.macOS">
      <HintPath>$(RhinoResources)/Microsoft.macOS.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Porta.Pty" Version="1.0.7" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\icon.png" LogicalName="RhinoClaudePanel.icon.png" />
  </ItemGroup>

  <!-- Flatten native libs to TargetDir root so the loader finds them via the plugin assembly dir. -->
  <Target Name="FlattenNativeLibs" AfterTargets="Build">
    <ItemGroup Condition="'$(OS)' == 'Unix'">
      <NativeLib Include="$(TargetDir)runtimes/osx-arm64/native/*.dylib" />
      <NativeLib Include="$(TargetDir)runtimes/osx-x64/native/*.dylib" />
    </ItemGroup>
    <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
      <NativeLib Include="$(TargetDir)runtimes\win-x64\native\*.dll" />
      <NativeLib Include="$(TargetDir)runtimes\win-x64\native\*.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeLib)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'@(NativeLib)' != ''" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" DependsOnTargets="FlattenNativeLibs">
    <ItemGroup>
      <PluginFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <RemoveDir Directories="$(PluginDestDir)" />
    <MakeDir Directories="$(PluginDestDir)" />
    <Copy SourceFiles="@(PluginFiles)" DestinationFiles="@(PluginFiles->'$(PluginDestDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Text="RhinoClaudePanel installed to $(PluginDestDir)" Importance="high" />
  </Target>
</Project>
